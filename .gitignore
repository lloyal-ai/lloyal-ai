node_modules/
dist/
*.tsbuildinfo
.DS_Store

# Internal design notes are not published from this repo, which is public.
# Anchored: templates/*/docs/ ships (the scaffold's design record).
/docs/

# Scaffold output produced by running a template in place. These live at the
# repo root because it IS the package root — npm's `files` allowlist is what
# keeps templates/ in the tarball regardless, verified with `npm pack`.
templates/*/out/
templates/*/dist-web/
templates/*/traces/
templates/*/*.log
templates/*/models/**/*.gguf

# In-place template development (lloyal link-local inside templates/<t>):
# runtime residue only — the link mutates nothing tracked.
templates/*/node_modules/
templates/*/package-lock.json
templates/*/models/**/*.gguf
templates/*/reports/
templates/*/media/
templates/*/vendor/
templates/*/harness.json
