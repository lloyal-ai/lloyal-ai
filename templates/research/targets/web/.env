# The served box's settings — this file is committed, so it holds the defaults a
# reader should see, never one machine's numbers. Override those in `.env.local`,
# which git ignores; a real environment variable beats both, so a one-off is
# `MAX_SESSIONS=2 npm run serve`.
#
# Both halves of the web target read this directory: `bin/serve.js` loads it for
# the host, and Vite loads it for the browser bundle (the `VITE_` names only).

# Where the host listens. Loopback by default: the pilot has no auth, so serving
# every interface is an explicit choice.
HOST=127.0.0.1
PORT=8787

# How many browser sessions may be RESIDENT at once — not how many are working.
# Each holds its own context, reranker and projector for as long as its tab is
# open, so a reader who finishes a brief and walks away still holds a slot; the
# rest queue. Size it against the model, the context length and vision actually
# configured, with the sessions IDLE, not against how many can run a query.
MAX_SESSIONS=4

# Where the browser fetches bytes from, when it is not the same origin as the
# socket. Empty means "wherever this page came from" — the dev proxy's case.
# LLOYAL_CONTENT_ORIGIN=
# VITE_WSS_URL=
# VITE_CONTENT_URL=
