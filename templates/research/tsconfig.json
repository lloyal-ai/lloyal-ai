{
  // The Node half: the engine (`src/app.ts`, `src/harness/`), the terminal view, and the boot
  // entries under `targets/` that run in Node. `tsc` only typechecks here; esbuild makes the bundles, because
  // The tree is split by where code RUNS, across three configs: the browser and Electron renderer sources are
  // checked by tsconfig.web.json, the Electron main and preload by tsconfig.electron.json. `npm run typecheck`
  // runs all three; a bare `tsc` runs only this one.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*", "targets/**/*", "types/**/*"],
  // Excluded: what needs a DOM (tsconfig.web.json checks it) and the Electron entries. What stays under
  // `src/ui/` is node-free and shared by every surface: the fold, the selectors, the pace record, and the
  // terminal view, which is Ink and so runs in Node. A new file that touches the DOM belongs in this list.
  "exclude": [
    "src/ui/App.tsx",
    "src/ui/moments",
    "src/ui/parts",
    "src/ui/content-urls.ts",
    "src/ui/history.ts",
    "src/ui/theme.ts",
    "targets/desktop",
    "targets/web/main.tsx",
    "targets/web/boot.ts",
    "targets/web/web-bridge.ts"
  ]
}
