{
  "name": "__NAME__",
  "version": "0.1.0",
  "private": true,
  "description": "A vertical inference harness scaffolded by `lloyal`.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "__NAME__": "bin/run.js"
  },
  "main": "out/main/main.js",
  "files": [
    "bin/",
    "dist/",
    "harness.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx targets/cli/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.electron.json",
    "prestart": "node bin/preflight-abilities.js && tsc",
    "start": "node bin/run.js",
    "predev:desktop": "node bin/preflight-abilities.js && node bin/ensure-electron.js",
    "dev:desktop": "tsc && cross-env LLOYAL_DEV=1 electron-vite dev",
    "prebuild:desktop": "node bin/preflight-abilities.js && node bin/ensure-electron.js",
    "build:desktop": "tsc && electron-vite build",
    "serve": "tsc && node bin/serve.js",
    "dev:web": "concurrently -k -n serve,web -c blue,magenta \"cross-env LLOYAL_DEV=1 npm run serve\" \"vite --config targets/web/vite.web.config.ts\"",
    "dev:web:client": "vite --config targets/web/vite.web.config.ts",
    "build:web": "vite build --config targets/web/vite.web.config.ts"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@lloyal-labs/binding": "^0.1.0",
    "@lloyal-labs/dev-tools": "^0.4.1",
    "@lloyal-labs/host": "^0.1.0",
    "@lloyal-labs/lloyal-agents": "^5.5.1",
    "@lloyal-labs/lloyal.node": "^3.1.0",
    "@lloyal-labs/rig": "^5.5.0",
    "@lloyal-labs/sdk": "^3.0.3",
    "effection": "^4.1.0",
    "ink": "^7.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.0",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
